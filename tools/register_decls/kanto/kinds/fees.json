{
 "schema": "thth.kind/1",
 "kind": "fees",
 "place": "fees/[0-9]*.json",
 "format": "json",
 "records": "file",
 "id": {
  "name": true
 },
 "max_bytes": 400000,
 "pointers": [
  {
   "field": "school_id",
   "meaning": "about",
   "to": "target"
  }
 ],
 "units": {
  "groups": [
   "admissions_extra"
  ],
  "items": [
   "rounds",
   "*"
  ],
  "key": [
   "group.year",
   "round",
   "date"
  ],
  "time": {
   "group": "year"
  },
  "scope": {
   "separate": [
    "capacity"
   ],
   "fields": {
    "capacity": "capacity_shared"
   }
  }
 },
 "checks": [
  {
   "check": "required",
   "id": "k_f2_fees",
   "level": "warn",
   "fields": [
    "_agent"
   ],
   "note": "access_fees_lint 282 行"
  },
  {
   "check": "words",
   "id": "k_f16_kind",
   "field": "first_year_total.kind",
   "in": [
    "公式記載",
    "合算",
    "不明"
   ],
   "allow_blank": false,
   "note": "first_year_total が在り kind が 3 語（access_fees_lint 607〜624 行）"
  },
  {
   "check": "required",
   "id": "k_f16_amount",
   "when": {
    "first_year_total.kind": {
     "in": [
      "公式記載"
     ]
    }
   },
   "fields": [
    "first_year_total.amount"
   ],
   "note": "公式記載なら amount が null でない（同 629〜630 行）"
  }
 ]
}
