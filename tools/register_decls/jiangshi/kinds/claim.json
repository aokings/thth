{
 "schema": "thth.kind/1",
 "kind": "claim",
 "place": "data/claims.csv",
 "format": "csv",
 "id": {
  "field": "id"
 },
 "questions": [
  {
   "name": "says_so",
   "state": "claim_status",
   "depends": [
    "subject_entity_id",
    "predicate",
    "object_entity_id",
    "object_text_ja",
    "scope_ja"
   ]
  }
 ],
 "pointers": [
  {
   "field": "subject_entity_id",
   "meaning": "about",
   "to": "entity"
  },
  {
   "field": "object_entity_id",
   "meaning": "related",
   "to": "entity"
  }
 ],
 "checks": [
  {
   "check": "shape",
   "id": "j_1_claim",
   "field": "id",
   "shape": "slug",
   "allow_blank": false,
   "note": "validate_data.py 134〜141 行（images は 284〜287 行）"
  },
  {
   "check": "unique",
   "id": "j_2_claim",
   "fields": [
    "id"
   ]
  },
  {
   "check": "words",
   "id": "j_3_claim_claim_status",
   "field": "claim_status",
   "in": [
    "established",
    "supported",
    "preliminary",
    "contested",
    "contextual",
    "observation",
    "unverified"
   ],
   "allow_blank": false
  },
  {
   "check": "words",
   "id": "j_3_claim_claim_type",
   "field": "claim_type",
   "in": [
    "source_record",
    "work_setting",
    "lab_reading"
   ],
   "allow_blank": false
  },
  {
   "check": "words",
   "id": "j_3_claim_predicate",
   "field": "predicate",
   "in": [
    "is_a",
    "includes",
    "bonds_via",
    "works_by",
    "requires",
    "applicable_to",
    "soluble_in",
    "insoluble_in",
    "contains",
    "causes",
    "attributed_to",
    "produces",
    "used_in",
    "found_in",
    "differs_from",
    "has_property",
    "declined_because",
    "regulated_by",
    "appears_in",
    "adapted_from",
    "sequel_of",
    "released_in",
    "translated_as"
   ],
   "allow_blank": false
  },
  {
   "check": "required",
   "id": "j_8",
   "fields": [
    "object_text_ja"
   ],
   "when": {
    "object_entity_id": {
     "blank": true
    }
   }
  },
  {
   "check": "shape",
   "id": "j_9_updated_at",
   "field": "updated_at",
   "shape": "date",
   "allow_blank": false
  },
  {
   "check": "shape",
   "id": "j_9_as_of",
   "field": "as_of",
   "shape": "date_partial"
  },
  {
   "check": "shape",
   "id": "j_9_valid_until",
   "field": "valid_until",
   "shape": "date_partial"
  },
  {
   "check": "count",
   "id": "j_19",
   "when": {
    "claim_status": {
     "not_in": [
      "unverified"
     ]
    }
   },
   "from": {
    "kind": "evidence",
    "via": "claim_id"
   },
   "min": 1,
   "note": "relation は問わない（268〜269 行）"
  },
  {
   "check": "count",
   "id": "j_20",
   "when": {
    "claim_status": {
     "in": [
      "established"
     ]
    }
   },
   "from": {
    "kind": "evidence",
    "via": "claim_id"
   },
   "where": {
    "extraction_status": {
     "in": [
      "human_checked"
     ]
    }
   },
   "min": 1,
   "note": "今は判断でなく根拠の欄の語（270〜272 行）"
  },
  {
   "check": "count",
   "id": "j_21",
   "when": {
    "claim_status": {
     "in": [
      "established"
     ]
    }
   },
   "from": {
    "kind": "evidence",
    "via": "claim_id"
   },
   "where": {
    "relation": {
     "in": [
      "supports"
     ]
    }
   },
   "distinct": "source_id",
   "min": 2,
   "note": "文は「独立した出典」・数えるのは違う番号（273〜274 行）"
  },
  {
   "check": "count",
   "id": "j_22",
   "when": {
    "claim_status": {
     "in": [
      "established",
      "supported"
     ]
    }
   },
   "from": {
    "kind": "evidence",
    "via": "claim_id"
   },
   "where": {
    "evidence_type": {
     "not_in": [
      "reference_work",
      "creator_statement",
      "promotional",
      "journalistic_report"
     ]
    }
   },
   "min": 1,
   "note": "言い換え: 根拠の全部が contextual_cap_types なら赤（275〜277 行）を「上限外の種類の根拠が 1 つ以上」に。根拠 0 の主張は j_19 が別に赤にするので答えは同じ"
  }
 ]
}
