{
 "schema": "thth.kind/1",
 "kind": "q_readings",
 "place": "data/questions/*/readings.csv",
 "format": "csv",
 "records": "rows",
 "id": {
  "field": "reading_id"
 },
 "pointers": [
  {
   "field": "row_ids",
   "meaning": "derived_from",
   "to": "q_results",
   "split": ";",
   "note": "台本は ; と , のどちらでも切る（実物の , は 0）。器の区切りは 1 字だけ"
  }
 ],
 "checks": [
  {
   "check": "required",
   "id": "n4_41_read_req",
   "fields": [
    "reading_id",
    "kind",
    "sort",
    "text_ja",
    "text_en"
   ],
   "note": "N4-41（scripts/gate_question_tables.py 40）"
  },
  {
   "check": "words",
   "id": "n4_41_read_kind",
   "field": "kind",
   "in": [
    "answer",
    "confirmed",
    "candidate",
    "unseparable"
   ],
   "allow_blank": false,
   "note": "N4-41（scripts/gate_question_tables.py 31）"
  },
  {
   "check": "required",
   "id": "n4_41_read_rows",
   "fields": [
    "row_ids"
   ],
   "when": {
    "kind": {
     "not_in": [
      "answer"
     ]
    }
   },
   "note": "N4-41（scripts/gate_question_tables.py 166〜168）"
  }
 ],
 "note": "番号は問いの中でだけ一意（問いをまたぐと重なる）。器は番号に置き場を入れられないので、重なりは読みの問題 id_duplicate に出る"
}
