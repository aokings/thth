{
 "schema": "thth.kind/1",
 "kind": "lab_recipe_step",
 "place": "data/lab-recipe-steps.csv",
 "format": "csv",
 "records": "rows",
 "id": {
  "field": "id"
 },
 "pointers": [
  {
   "field": "recipe_id",
   "meaning": "parent",
   "to": "lab_recipe"
  },
  {
   "field": "claim_ids",
   "meaning": "supports",
   "to": "claim",
   "split": ";"
  }
 ],
 "checks": [
  {
   "check": "shape",
   "id": "ids_lab_recipe_step",
   "field": "id",
   "shape": "slug_loose",
   "allow_blank": false,
   "note": "scripts/validate_data.py 353〜365 の check_ids（id の形 ^[a-z0-9][a-z0-9-]*$）。§4.6"
  },
  {
   "check": "required",
   "id": "req_lab_recipe_step",
   "fields": [
    "id",
    "recipe_id",
    "step_no",
    "text",
    "effect",
    "effect_note"
   ],
   "note": "scripts/validate_data.py 46〜96 の REQUIRED を空にしない（check_ids）。§4.6"
  },
  {
   "check": "words",
   "id": "v_step_effect",
   "field": "effect",
   "in": [
    "reduces",
    "unchanged",
    "increases",
    "keeps",
    "contested",
    "unverified"
   ],
   "allow_blank": false,
   "note": "scripts/validate_data.py 863〜864"
  },
  {
   "check": "required",
   "id": "n4_35",
   "fields": [
    "claim_ids"
   ],
   "when": {
    "effect": {
     "in": [
      "reduces",
      "unchanged",
      "increases",
      "keeps"
     ]
    }
   },
   "note": "N4-35（scripts/validate_data.py 869〜870）"
  }
 ]
}
