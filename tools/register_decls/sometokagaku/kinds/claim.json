{
 "schema": "thth.kind/1",
 "kind": "claim",
 "place": "data/claims.csv",
 "format": "csv",
 "id": {
  "field": "id"
 },
 "questions": [
  {
   "name": "says_so",
   "state": "claim_status",
   "depends": [
    "subject_entity_id",
    "predicate",
    "object_entity_id",
    "object_text_ja",
    "object_text_en",
    "scope_ja",
    "scope_en"
   ]
  }
 ],
 "pointers": [
  {
   "field": "subject_entity_id",
   "meaning": "about",
   "to": "entity"
  },
  {
   "field": "object_entity_id",
   "meaning": "related",
   "to": "entity"
  }
 ],
 "checks": [
  {
   "check": "shape",
   "id": "s_v1_claim",
   "field": "id",
   "shape": "slug",
   "allow_blank": false,
   "note": "validate_data.py 100〜107 行"
  },
  {
   "check": "unique",
   "id": "s_v2_claim",
   "fields": [
    "id"
   ]
  },
  {
   "check": "words",
   "id": "s_v3_claim_predicate",
   "field": "predicate",
   "in": [
    "is_a",
    "includes",
    "bonds_via",
    "works_by",
    "requires",
    "applicable_to",
    "soluble_in",
    "insoluble_in",
    "contains",
    "causes",
    "attributed_to",
    "produces",
    "used_in",
    "found_in",
    "differs_from",
    "has_property",
    "declined_because",
    "regulated_by"
   ],
   "allow_blank": false
  },
  {
   "check": "words",
   "id": "s_v3_claim_claim_type",
   "field": "claim_type",
   "in": [
    "classification",
    "composition",
    "mechanism",
    "process",
    "applicability",
    "color",
    "fastness",
    "cultural",
    "historical",
    "safety",
    "environmental",
    "regulatory"
   ],
   "allow_blank": false
  },
  {
   "check": "words",
   "id": "s_v3_claim_claim_status",
   "field": "claim_status",
   "in": [
    "established",
    "supported",
    "preliminary",
    "contested",
    "contextual",
    "observation",
    "unverified"
   ],
   "allow_blank": false
  },
  {
   "check": "required",
   "id": "s_v4_claim_object_text_en",
   "fields": [
    "object_text_en"
   ],
   "when": {
    "object_text_ja": {
     "blank": false
    }
   },
   "note": "日英は両方埋めるか両方空（122〜126 行）を 2 本で"
  },
  {
   "check": "required",
   "id": "s_v4_claim_object_text_ja",
   "fields": [
    "object_text_ja"
   ],
   "when": {
    "object_text_en": {
     "blank": false
    }
   }
  },
  {
   "check": "required",
   "id": "s_v4_claim_scope_en",
   "fields": [
    "scope_en"
   ],
   "when": {
    "scope_ja": {
     "blank": false
    }
   },
   "note": "日英は両方埋めるか両方空（122〜126 行）を 2 本で"
  },
  {
   "check": "required",
   "id": "s_v4_claim_scope_ja",
   "fields": [
    "scope_ja"
   ],
   "when": {
    "scope_en": {
     "blank": false
    }
   }
  },
  {
   "check": "required",
   "id": "s_v8",
   "fields": [
    "object_text_ja"
   ],
   "when": {
    "object_entity_id": {
     "blank": true
    }
   }
  },
  {
   "check": "shape",
   "id": "s_v9_updated_at",
   "field": "updated_at",
   "shape": "date",
   "allow_blank": false
  },
  {
   "check": "shape",
   "id": "s_v9_as_of",
   "field": "as_of",
   "shape": "date_partial"
  },
  {
   "check": "shape",
   "id": "s_v9_valid_until",
   "field": "valid_until",
   "shape": "date_partial"
  },
  {
   "check": "count",
   "id": "s_v14",
   "when": {
    "claim_status": {
     "not_in": [
      "unverified"
     ]
    }
   },
   "from": {
    "kind": "evidence",
    "via": "claim_id"
   },
   "min": 1
  },
  {
   "check": "count",
   "id": "s_v15",
   "when": {
    "claim_status": {
     "in": [
      "established"
     ]
    }
   },
   "from": {
    "kind": "evidence",
    "via": "claim_id"
   },
   "where": {
    "extraction_status": {
     "in": [
      "human_checked"
     ]
    }
   },
   "min": 1,
   "note": "今は根拠の欄の語"
  },
  {
   "check": "count",
   "id": "s_v16",
   "when": {
    "claim_status": {
     "in": [
      "established"
     ]
    }
   },
   "from": {
    "kind": "evidence",
    "via": "claim_id"
   },
   "where": {
    "relation": {
     "in": [
      "supports"
     ]
    }
   },
   "distinct": "source_id",
   "min": 2,
   "note": "文は「独立した出典」・数えるのは違う番号"
  },
  {
   "check": "count",
   "id": "s_v17",
   "when": {
    "claim_status": {
     "in": [
      "established",
      "supported"
     ]
    }
   },
   "from": {
    "kind": "evidence",
    "via": "claim_id"
   },
   "where": {
    "evidence_type": {
     "not_in": [
      "manufacturer_statement",
      "institutional_summary",
      "practitioner_report",
      "journalistic_report"
     ]
    }
   },
   "min": 1,
   "note": "言い換え: 根拠の全部が上限の 4 種なら赤（206〜209 行）を「上限外の根拠が 1 つ以上」に。根拠 0 は s_v14 が別に赤にする"
  }
 ]
}
