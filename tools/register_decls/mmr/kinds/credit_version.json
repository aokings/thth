{
 "schema": "thth.kind/1",
 "kind": "credit_version",
 "place": "site/src/credit-versions/versions.json",
 "format": "json",
 "records": "rows",
 "rows_at": [
  "rows"
 ],
 "max_bytes": 2000000,
 "id": {
  "key": [
   "claim",
   "seed"
  ]
 },
 "pointers": [
  {
   "field": "claim",
   "meaning": "derived_from",
   "to": "claim"
  },
  {
   "field": "seed",
   "meaning": "about",
   "to": "song"
  },
  {
   "field": "seed",
   "meaning": "about",
   "to": "shelf_song"
  },
  {
   "field": "subject",
   "meaning": "about",
   "to": "entity"
  },
  {
   "field": "object",
   "meaning": "related",
   "to": "entity"
  },
  {
   "field": "object_seeds",
   "meaning": "related",
   "to": "song"
  }
 ],
 "checks": [
  {
   "check": "forbid_pair",
   "id": "m_w2",
   "when": {
    "status": {
     "in": [
      "shown"
     ]
    }
   },
   "via": "seed",
   "via_to": "shelf_song",
   "target": {
    "identity_status": {
     "in": [
      "unresolved"
     ]
    }
   },
   "note": "V4: shown なら shelf.json の曲が unresolved でない（803〜805 行）。seed の 2 本の指す欄のうち shelf_song を選ぶ"
  },
  {
   "check": "empty",
   "id": "m_w6",
   "when": {
    "status": {
     "in": [
      "shown"
     ]
    },
    "mb.verdict": {
     "in": [
      "別の録音を指す"
     ]
    }
   },
   "fields": [
    "mb.verdict"
   ],
   "note": "V5: shown なら mb.verdict が「別の録音を指す」でない（816〜817 行）。when に合う行では mb.verdict が必ず空でないので、empty で「この組の行が無い」を言う"
  },
  {
   "check": "words",
   "id": "m_w4_status",
   "field": "status",
   "in": [
    "shown",
    "held"
   ]
  },
  {
   "check": "required",
   "id": "m_w4_shown",
   "when": {
    "status": {
     "in": [
      "shown"
     ]
    }
   },
   "fields": [
    "mark",
    "next_check_ja"
   ]
  },
  {
   "check": "required",
   "id": "m_w4_held",
   "when": {
    "status": {
     "in": [
      "held"
     ]
    }
   },
   "fields": [
    "held_kind",
    "held_reason_ja"
   ]
  }
 ]
}
