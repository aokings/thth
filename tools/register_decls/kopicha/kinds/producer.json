{
 "schema": "thth.kind/1",
 "kind": "producer",
 "place": "src/content/producers/*.yaml",
 "format": "yaml",
 "records": "file",
 "id": {
  "name": true
 },
 "max_bytes": 262144,
 "pointers": [
  {
   "template": "producer-{id}",
   "meaning": "same",
   "to": "point",
   "note": "枚と台帳の点の暗黙の結び（頁が <接頭>-<ファイル名> で点を引く）"
  },
  {
   "field": "article",
   "meaning": "related",
   "to": "article"
  },
  {
   "field": "origin",
   "meaning": "parent",
   "to": "origin",
   "note": "X4-5 の「生産者の origin が在る」"
  }
 ],
 "checks": [
  {
   "check": "words",
   "id": "z4_1_producer_kind",
   "field": "kind",
   "in": [
    "estate",
    "farm",
    "station",
    "coop"
   ],
   "allow_blank": false,
   "note": "Z4-1（src/content.config.ts の z.enum）"
  },
  {
   "check": "words",
   "id": "z4_1_producer_domain",
   "field": "domain",
   "in": [
    "coffee",
    "tea"
   ],
   "allow_blank": false,
   "note": "Z4-1（src/content.config.ts の z.enum）"
  },
  {
   "check": "required",
   "id": "z4_2_producer",
   "fields": [
    "name",
    "kind",
    "domain",
    "origin",
    "summary",
    "updated"
   ],
   "note": "Z4-2（src/content.config.ts の要る欄）"
  }
 ]
}
