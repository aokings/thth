{
 "schema": "thth.kind/1",
 "kind": "article",
 "place": "src/content/articles/*.md",
 "format": "md_yaml",
 "records": "file",
 "id": {
  "name": true
 },
 "max_bytes": 1048576,
 "checks": [
  {
   "check": "words",
   "id": "z4_1_article_category",
   "field": "category",
   "in": [
    "coffee",
    "tea",
    "column"
   ],
   "note": "Z4-1（src/content.config.ts 9 の z.enum）"
  },
  {
   "check": "required",
   "id": "z4_2_article",
   "fields": [
    "title",
    "description",
    "pubDate"
   ],
   "note": "Z4-2（src/content.config.ts 4〜15 の要る欄）"
  }
 ],
 "note": "頭つき MD（Astro の frontmatter）。頭の段の鍵が欄、本文は _body。番号はファイル名（slug）"
}
