{
 "schema": "thth.kind/1",
 "kind": "origin",
 "place": "src/content/origins/*.yaml",
 "format": "yaml",
 "records": "file",
 "id": {
  "name": true
 },
 "max_bytes": 262144,
 "pointers": [
  {
   "template": "origin-{id}",
   "meaning": "same",
   "to": "point",
   "note": "枚と台帳の点の暗黙の結び（頁が <接頭>-<ファイル名> で点を引く）"
  },
  {
   "field": "article",
   "meaning": "related",
   "to": "article"
  },
  {
   "field": "parent",
   "meaning": "parent",
   "to": "origin",
   "none": [
    "null",
    "~"
   ],
   "note": "国の産地は parent: null（先なし）。region は国の産地を指す"
  }
 ],
 "checks": [
  {
   "check": "words",
   "id": "z4_1_origin_domain",
   "field": "domain",
   "in": [
    "coffee",
    "tea"
   ],
   "allow_blank": false,
   "note": "Z4-1（src/content.config.ts の z.enum）"
  },
  {
   "check": "words",
   "id": "z4_1_origin_level",
   "field": "level",
   "in": [
    "country",
    "region"
   ],
   "allow_blank": true,
   "note": "Z4-1（src/content.config.ts の z.enum）"
  },
  {
   "check": "required",
   "id": "z4_2_origin",
   "fields": [
    "name",
    "domain",
    "summary",
    "updated"
   ],
   "note": "Z4-2（src/content.config.ts の要る欄）"
  },
  {
   "check": "words",
   "id": "x4_5_parent",
   "field": "level",
   "in": [
    "country"
   ],
   "allow_blank": true,
   "when": {
    "parent": {
     "in": [
      null,
      "~"
     ],
     "or_blank": true
    }
   },
   "note": "X4-5 のうち「region の産地は parent が要る」（tests/explain-content.test.mjs 156〜185）を、「parent が null か空なら level は country（既定）」と言い換えた"
  }
 ]
}
