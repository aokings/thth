{
 "schema": "thth.kind/1",
 "kind": "variety",
 "place": "src/content/varieties/*.yaml",
 "format": "yaml",
 "records": "file",
 "id": {
  "name": true
 },
 "max_bytes": 262144,
 "pointers": [
  {
   "template": "variety-{id}",
   "meaning": "same",
   "to": "point",
   "note": "枚と台帳の点の暗黙の結び（頁が <接頭>-<ファイル名> で点を引く）"
  },
  {
   "field": "parents",
   "meaning": "parent",
   "to": "variety",
   "note": "系統（親品種のファイル名の並び）"
  }
 ],
 "checks": [
  {
   "check": "words",
   "id": "z4_1_variety_domain",
   "field": "domain",
   "in": [
    "coffee",
    "tea"
   ],
   "allow_blank": false,
   "note": "Z4-1（src/content.config.ts の z.enum）"
  },
  {
   "check": "required",
   "id": "z4_2_variety",
   "fields": [
    "name",
    "domain",
    "origin",
    "summary"
   ],
   "note": "Z4-2（src/content.config.ts の要る欄）"
  }
 ]
}
