{
 "schema": "thth.kind/1",
 "kind": "term",
 "place": "src/content/terms/*.yaml",
 "format": "yaml",
 "records": "file",
 "id": {
  "name": true
 },
 "max_bytes": 262144,
 "pointers": [
  {
   "template": "term-{id}",
   "meaning": "same",
   "to": "point",
   "note": "枚と台帳の点の暗黙の結び（頁が <接頭>-<ファイル名> で点を引く）"
  },
  {
   "field": "article",
   "meaning": "related",
   "to": "article"
  }
 ],
 "checks": [
  {
   "check": "words",
   "id": "z4_1_term_field",
   "field": "field",
   "in": [
    "process",
    "roast",
    "teaType",
    "grade",
    "flush"
   ],
   "allow_blank": false,
   "note": "Z4-1（src/content.config.ts の z.enum）"
  },
  {
   "check": "words",
   "id": "z4_1_term_domain",
   "field": "domain",
   "in": [
    "coffee",
    "tea"
   ],
   "allow_blank": false,
   "note": "Z4-1（src/content.config.ts の z.enum）"
  },
  {
   "check": "required",
   "id": "z4_2_term",
   "fields": [
    "name",
    "domain",
    "field",
    "summary",
    "updated"
   ],
   "note": "Z4-2（src/content.config.ts の要る欄）"
  }
 ]
}
