{
  "schema": "thth.kind/1",
  "kind": "account",
  "place": "account/*.json",
  "format": "json",
  "records": "file",
  "id": {"name": true},
  "checks": [
    {"check": "required", "id": "name_and_media", "fields": ["name", "media"]},
    {"check": "shape", "id": "url", "field": "url", "shape": "https_url", "allow_blank": true},
    {"check": "empty", "id": "no_keys",
     "fields": ["token", "access_token", "refresh_token", "password", "app_password", "secret", "api_key", "key"],
     "note": "鍵は台帳に入れない（鍵は THTH の側の口座と主体が持つ）"}
  ],
  "note": "共通の台帳の備え付けの種類（台帳の器 段 8）。口座の一覧: 名前（name）・媒体（media）・向き先（url）。鍵の欄は無い。thth register add <台帳> --common が写す"
}
