      "evidence": {
        "type": "inferred",
        "by": "Fable（設計 §4.2）・masaru「スレッズなどより緩く」",
        "at": "2026-10-17"
      },
      "confidence": "low",
      "signals": [
        "bookmark.burst",
        "bookmark.daily"
      ],
      "defaults": {
        "bookmark.burst": {
          "signal": "frequency",
          "actions": [
            "bookmark_add",
            "bookmark_delete"
          ],
          "scope": "principal",
          "window": {
            "minutes": 10
          },
          "count": 10,
          "key": "op",
          "on_exceed": "wait",
          "purpose": "preference",
          "tighter": "lower",
          "applies_to": [
