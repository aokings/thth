      "defaults": {
        "bookmark.retry_once": {
          "signal": "same_target",
          "actions": [
            "bookmark_add"
          ],
          "scope": "principal",
          "window": {
            "forever": true
          },
          "count": 1,
          "key": "url",
          "on_exceed": "refuse",
          "purpose": "platform",
          "count_evidence": "inferred"
        }
      }
    },
    {
      "id": "hatenabookmark.self_site_allowed",
      "kind": "good_signal",
      "statement": "自分が運営するウェブサイトを自分のアカウントでブックマークする行為は特に問題にしていない",
      "evidence": {
        "type": "official_doc",
        "url": "https://b.hatena.ne.jp/help/entry/spam",
        "checked_at": "2026-10-17",
        "quote": "ご自身が運営するウェブサイトを自身のアカウントでブックマークする行為については、特に問題としておらず"
      },
      "confidence": "high",
      "signals": [
        "bookmark.self_daily"
      ]
    },
    {
      "id": "hatenabookmark.skew_correction",
      "kind": "penalty",
      "statement": "特定のサイトやコンテンツにだけ多くブックマークする偏りは、作為的でなくても補正する。組織的な順位操作やスパムは機械的に監視・措置",
      "evidence": {
        "type": "official_doc",
        "url": "https://b.hatena.ne.jp/guide/guideline",
