{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thth-callback",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [{"binding":"MEDIA_BUCKET","bucket_name":"thth-media"}],
  "durable_objects": {"bindings": [{"name":"MEDIA_OBJECT","class_name":"MediaObject"}, {"name": "AUTH_RELAY", "class_name": "AuthRelay"}, {"name":"PERSON","class_name":"Person"}, {"name":"ACCOUNT","class_name":"Account"}, {"name":"DELETION_INBOX","class_name":"DeletionInbox"}, {"name":"INVITE_OBJECT","class_name":"InviteObject"}, {"name":"LOGIN","class_name":"Login"}]},
  "migrations": [{"tag": "v1-relay", "new_sqlite_classes": ["AuthRelay"]}, {"tag":"v2-approval","new_sqlite_classes":["ApprovalPerson","ApprovalSession"]}, {"tag":"v3-leave","new_sqlite_classes":["ApprovalAccount","DeletionInbox"]}, {"tag":"v4-media","new_sqlite_classes":["MediaObject"]}, {"tag":"v5-invite","new_sqlite_classes":["InviteObject"]}, {"tag":"v6-no-approval-session","deleted_classes":["ApprovalSession"]}, {"tag":"v7-rename-person","renamed_classes":[{"from":"ApprovalPerson","to":"Person"},{"from":"ApprovalAccount","to":"Account"}]}, {"tag":"v8-login","new_sqlite_classes":["Login"]}],
  "ratelimits": [{"name":"MEDIA_PUBLIC_LIMIT","namespace_id":"21301","simple":{"limit":120,"period":60}},
    {"name":"MEDIA_CONTROL_LIMIT","namespace_id":"21302","simple":{"limit":600,"period":60}},
    {"name":"MEDIA_UPLOAD_IP_LIMIT","namespace_id":"21304","simple":{"limit":120,"period":60}},
    {"name":"MEDIA_UPLOAD_LIMIT","namespace_id":"21303","simple":{"limit":240,"period":60}},{"name":"DELETION_PUBLIC_LIMIT","namespace_id":"21204","simple":{"limit":120,"period":60}},{"name": "AUTH_RATE_LIMIT", "namespace_id": "21101",
                  "simple": {"limit": 120, "period": 60}},
    {"name":"RELAY_PUBLIC_LIMIT","namespace_id":"21201","simple":{"limit":120,"period":60}},
    {"name":"RELAY_VERIFY_LIMIT","namespace_id":"21202","simple":{"limit":600,"period":60}},
    {"name":"RELAY_JOB_LIMIT","namespace_id":"21203","simple":{"limit":180,"period":60}},
    // 3.14.0 遠くの道（/api/v1/*）: 鍵（bearer の sha256）ごとに 60 回／分。IP は RELAY_PUBLIC_LIMIT（120 回／分）。
    {"name":"API_KEY_LIMIT","namespace_id":"21401","simple":{"limit":60,"period":60}}],
  // thth.me を Worker の custom domain にする（DNS レコードは wrangler が作る）。
  "routes": [
    { "pattern": "thth.me", "custom_domain": true }
  ],
  // 製品の紹介ページ（設計 v2 §3「ドメイン」: thth.me ＝製品の入口）。
  // 中身は `python tools/build_site.py` が repo の正本から生成する
  // （`README.en.md`・`skills/thth/SKILL.md`・`llms.txt`。手で書かない）。
  // 通常は assets 優先。認可・relay・延期中metadata は Worker を先に通す。
  // VM→Worker の署名つき relay は 3.13.0 で /approval/* から /relay/v/*（/relay/* に含まれる）へ。
  // /approval/* は 3.12.0 の VM が deploy の間に叩くので 1 版の間だけ残す。
  // 3.14.0: 遠くの道の /api/*（CLI が鍵で叩く）も Worker を先に通す。
  // 3.14.2: ブラウザ式の thth login の /login/*（DO は Login・migration v8-login。回数制限は既存の
  // RELAY_PUBLIC_LIMIT と API_KEY_LIMIT を使い、新しい namespace は作らない）。
  // 3.13.0: DO の class と binding の名前を改めた（ApprovalPerson → Person・ApprovalAccount → Account。
  // migration v7-rename-person の renamed_classes で中身はそのまま）。回数制限は名前だけ改め、namespace_id は変えない。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*", "/media-upload/*", "/m/*", "/data-deletion", "/data-deletion-status", "/approve/*", "/approval/*", "/pending", "/pending/*", "/activity", "/activity/*", "/invite/*", "/relay/*", "/api/*", "/login/*", "/callback", "/callback/*", "/oauth/client-metadata.json"]
  },
  // observability は有効にしない。認可コードはクエリに乗るので、
  // ログに残す動機を最初から作らない（設計 §3.6 の礼儀と同じ趣旨）。
  "observability": { "enabled": false }
}
