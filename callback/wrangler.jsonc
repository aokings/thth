{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thth-callback",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [{"binding":"MEDIA_BUCKET","bucket_name":"thth-media"}],
  "durable_objects": {"bindings": [{"name":"MEDIA_OBJECT","class_name":"MediaObject"}, {"name": "AUTH_RELAY", "class_name": "AuthRelay"}, {"name":"APPROVAL_PERSON","class_name":"ApprovalPerson"}, {"name":"APPROVAL_SESSION","class_name":"ApprovalSession"}, {"name":"APPROVAL_ACCOUNT","class_name":"ApprovalAccount"}, {"name":"DELETION_INBOX","class_name":"DeletionInbox"}]},
  "migrations": [{"tag": "v1-relay", "new_sqlite_classes": ["AuthRelay"]}, {"tag":"v2-approval","new_sqlite_classes":["ApprovalPerson","ApprovalSession"]}, {"tag":"v3-leave","new_sqlite_classes":["ApprovalAccount","DeletionInbox"]}, {"tag":"v4-media","new_sqlite_classes":["MediaObject"]}],
  "ratelimits": [{"name":"MEDIA_PUBLIC_LIMIT","namespace_id":"21301","simple":{"limit":120,"period":60}},
    {"name":"MEDIA_CONTROL_LIMIT","namespace_id":"21302","simple":{"limit":600,"period":60}},
    {"name":"MEDIA_UPLOAD_LIMIT","namespace_id":"21303","simple":{"limit":240,"period":60}},{"name":"DELETION_PUBLIC_LIMIT","namespace_id":"21204","simple":{"limit":120,"period":60}},{"name": "AUTH_RATE_LIMIT", "namespace_id": "21101",
                  "simple": {"limit": 120, "period": 60}},
    {"name":"APPROVAL_PUBLIC_LIMIT","namespace_id":"21201","simple":{"limit":120,"period":60}},
    {"name":"APPROVAL_VERIFY_LIMIT","namespace_id":"21202","simple":{"limit":600,"period":60}},
    {"name":"APPROVAL_JOB_LIMIT","namespace_id":"21203","simple":{"limit":180,"period":60}}],
  // thth.me を Worker の custom domain にする（DNS レコードは wrangler が作る）。
  "routes": [
    { "pattern": "thth.me", "custom_domain": true }
  ],
  // 製品の紹介ページ（設計 v2 §3「ドメイン」: thth.me ＝製品の入口）。
  // 中身は `python tools/build_site.py` が repo の正本から生成する
  // （`README.en.md`・`skills/thth/SKILL.md`・`llms.txt`。手で書かない）。
  // 通常は assets 優先。認可・relay・延期中metadata は Worker を先に通す。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*", "/media-upload/*", "/m/*", "/data-deletion", "/data-deletion-status", "/approve/*", "/approval/*", "/relay/*", "/callback", "/callback/*", "/oauth/client-metadata.json"]
  },
  // observability は有効にしない。認可コードはクエリに乗るので、
  // ログに残す動機を最初から作らない（設計 §3.6 の礼儀と同じ趣旨）。
  "observability": { "enabled": false }
}
